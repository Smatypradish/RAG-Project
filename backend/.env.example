# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Admin account ---
# ADMIN_PASSWORD must be set to a strong value before the admin login works.
# It also signs session tokens, so keep it secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_TTL_MINUTES=60

# --- CORS ---
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Storage ---
CHROMADB_PATH=./chroma_db
# UPLOAD_DIR defaults to ./uploads if unset
# UPLOAD_DIR=./uploads

# --- Chunking / retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=200
TOP_K=5

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
